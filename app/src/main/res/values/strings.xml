    <string name="free_note">Enjoy, it\'s absolutely free. No ads, no purchases, no network. Your play time stays on this device.</string>
    <!-- REQ-049 rule 1, verbatim. -->
    <string name="privacy_text">Privacy: this game collects no data. It has no network access, no accounts and no analytics. Your puzzle progress and play times are stored only on this device and are deleted when the game is uninstalled.</string>
