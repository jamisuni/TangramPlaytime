<?xml version="1.0" encoding="utf-8"?>
<!-- No uses-permission element of any kind (owner rule 1, guardrail G-01). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- G-01 / REQ-010.A2: strip androidx.core's injected receiver permission; the project never calls ContextCompat.registerReceiver. -->
    <permission
        android:name="app.tangramplaytime.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="app.tangramplaytime.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- WO-009 S-58 (decisions.md 2026-10-22 "The first upload's identity: ..."): MainActivity's screenOrientation="portrait"
         makes Google Play infer android.hardware.screen.portrait as required; this line says it is not, so a device that
         cannot turn to portrait can install. A screen 600 dp or wider is the Tablet layout and turns (REQ-036; TYPE-007);
         a narrower one is letterboxed upright by Android (the carry of decisions.md 2026-10-18 "A phone is portrait from
         the manifest; a tablet is unlocked at run time"). -->
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />

    <!-- WO-009 S-57: the launcher icon is the adaptive icon made from DI-9 by tools/make_icon.py (REQ-048 rule 2 and A4).
         No roundIcon and no monochrome layer (minSdk 31; decisions.md 2026-10-22 "The launcher icon and the store icon
         are made from DI-9 by one generator."). -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- WO-006 TASK-031 · S-35: a phone is created in portrait, before its first frame (REQ-035 statement); MainActivity
             unlocks a tablet at run time (REQ-036; decisions.md 2026-10-17 Q1). `adjustResize` brings the soft keyboard's
             inset to Compose on API 26-29 too (S-35 step 4; Q3). The theme stays opaque: API 26 refuses an orientation
             request from a translucent activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
